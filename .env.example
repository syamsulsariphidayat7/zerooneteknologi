# Salin file ini menjadi .env.local dan sesuaikan nilainya.
# Update file ini setiap ada variabel env baru (aturan AGENTS.global.md).

# Alamat email tujuan form kontak (POST /api/contact).
# Default proyek ini: email resmi PT Zero One Teknologi.
CONTACT_TO_EMAIL=zeroone212117@gmail.com

# Pengiriman email form kontak via SMTP (ADR 0005).
# Untuk Gmail: SMTP_USER = alamat Gmail, SMTP_PASS = App Password
# (Google Account > Keamanan > Verifikasi 2 Langkah > Sandi aplikasi),
# BUKAN kata sandi akun biasa. Tanpa dua variabel ini, form kontak
# hanya mencatat pesan ke log server (tidak mengirim email).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=zeroone212117@gmail.com
SMTP_PASS=
